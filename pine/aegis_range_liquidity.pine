//@version=6
// Aegis Range Liquidity v1 — visualise the on-chain range-bound market-making thesis.
//
// WHAT THIS IS: a diagnostic that shows whether a pair is behaving like a range-bound
// FX/stable pair (fees accrue, impermanent loss stays bounded) or like a trending asset
// (IL compounds, fees stop mattering).
//
// WHY THIS SPECIFIC QUESTION (aegis/fx_quant_response.md):
//  - In equities/BTC "you miss the best 50 days" and holding cash/market-making loses.
//  - In a ZERO-DRIFT pair (EURC/USDC) there is no long-run drift, so the asset cannot
//    run away from you. That is a genuine structural difference, not a marketing claim.
//  - BUT the measured capacity is small: total on-chain EUR-stable TVL was ~$47M across
//    42 pools. Above roughly $50k-$250k you BECOME the pool and suffer adverse selection.
//  - A 42% APY pool with $1.2M TVL is a WARNING, not an opportunity. High APY on thin
//    TVL signalled mispricing/risk in every case measured here (Morpho showed 41,889%).
//
// IL MODEL: standard constant-product impermanent loss, IL(r) = 2*sqrt(r)/(1+r) - 1,
// where r = price ratio vs the entry anchor. Concentrated (v3-style) ranges AMPLIFY
// both fees and IL — the script shows the full-range baseline, which is the honest floor.
indicator("Aegis Range Liquidity v1", overlay=true, max_bars_back=5000)

// ---------------- inputs ----------------
grpA = "Anchor"
anchorMode = input.string("Rolling SMA", "Anchor mode", options=["Rolling SMA","Session open","Fixed start"], group=grpA,
     tooltip="IL is measured against the anchor. A rolling anchor is how a rebalancing market maker actually behaves.")
anchorLen  = input.int(200, "Anchor lookback", minval=10, maxval=2000, group=grpA)

grpV = "Volatility band"
volLen  = input.int(200, "Vol lookback", minval=20, maxval=2000, group=grpV)
bandSig = input.float(2.0, "Band width (sigma)", step=0.1, minval=0.5, maxval=5.0, group=grpV,
     tooltip="The research deployed liquidity inside a ~2 sigma band.")

grpF = "Fee model"
feeApr  = input.float(15.0, "Assumed fee APR % (in-range)", step=1.0, group=grpF,
     tooltip="Only accrues while price is INSIDE the band. Be conservative: thin pools decay.")
concX   = input.float(1.0, "Concentration multiplier", step=1.0, minval=1.0, maxval=100.0, group=grpF,
     tooltip="Concentrated liquidity multiplies EARNED FEES but multiplies IL by the same factor. Set >1 to see why concentration is a double-edged knife.")

// ---------------- anchor & ratio ----------------
anchor = anchorMode == "Rolling SMA" ? ta.sma(close, anchorLen) : anchorMode == "Session open" ? ta.valuewhen(ta.change(time("D")) != 0, open, 0) : nz(close[bar_index - math.min(bar_index, 4000)])
r = anchor != 0 and not na(anchor) ? close / anchor : na

// ---------------- volatility band ----------------
ret    = math.log(close / close[1])
volD   = ta.stdev(ret, volLen)
barsYr = 365.0 * (86400.0 / math.max(timeframe.in_seconds(), 1.0))
volAnn = volD * math.sqrt(barsYr)
// band expressed as a price range around the anchor, scaled to the lookback (not annualised)
band   = bandSig * volD * math.sqrt(anchorLen)
upper  = anchor + band
lower  = anchor - band

inBand = not na(band) and close <= upper and close >= lower

// ---------------- impermanent loss (constant product, full range) ----------------
il = not na(r) and (1 + r) != 0 ? 2 * math.sqrt(math.max(r, 0)) / (1 + r) - 1 : 0.0
ilConc = il * concX            // concentration amplifies IL

// ---------------- fee accrual (only while in range) ----------------
barsPerYear = barsYr
feeThisBar  = inBand ? (feeApr / 100.0) / barsPerYear : 0.0
var float feesCum = 0.0
feesCum += feeThisBar

// net position value vs simply holding the anchor asset (log-free, simple sum)
var float ilCum = 0.0
var float lastIl = 0.0
ilStep = ilConc - lastIl
ilCum += ilStep
lastIl := ilConc

netEdge = feesCum + ilCum

// ---------------- in-range statistics ----------------
var int barsTotal = 0
var int barsIn    = 0
barsTotal += 1
if inBand
    barsIn += 1
pctIn = barsTotal > 0 ? 100.0 * barsIn / barsTotal : 0.0

// ---------------- plots ----------------
pU = plot(upper, "Upper band", color=color.new(color.red, 60))
pL = plot(lower, "Lower band", color=color.new(color.green, 60))
fill(pU, pL, color = inBand ? color.new(color.teal, 88) : color.new(color.orange, 92), title="Range zone")
plot(anchor, "Anchor", color=color.new(color.blue, 20), linewidth=2)

plotshape(not inBand and inBand[1], "Exited range",  style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.tiny)
plotshape(inBand and not inBand[1], "Entered range", style=shape.triangleup,   location=location.belowbar, color=color.teal,   size=size.tiny)

// ---------------- diagnostics ----------------
var table t = table.new(position.top_right, 2, 9, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Aegis Range Liquidity v1", bgcolor=color.new(color.teal, 70), text_color=color.white)
    table.cell(t, 1, 0, "diagnostic only",          bgcolor=color.new(color.teal, 70), text_color=color.white)
    table.cell(t, 0, 1, "Realised vol (ann.)")
    table.cell(t, 1, 1, str.tostring(volAnn * 100, "#.1") + "%")
    table.cell(t, 0, 2, "Price ratio vs anchor")
    table.cell(t, 1, 2, str.tostring(r, "#.0000"))
    table.cell(t, 0, 3, "In range")
    table.cell(t, 1, 3, str.tostring(pctIn, "#.0") + "%", text_color = pctIn > 70 ? color.green : pctIn > 40 ? color.orange : color.red)
    table.cell(t, 0, 4, "Cum. fees earned")
    table.cell(t, 1, 4, str.tostring(feesCum * 100, "#.2") + "%")
    table.cell(t, 0, 5, "Cum. impermanent loss")
    table.cell(t, 1, 5, str.tostring(ilCum * 100, "#.2") + "%", text_color=color.red)
    table.cell(t, 0, 6, "NET edge vs holding")
    table.cell(t, 1, 6, str.tostring(netEdge * 100, "#.2") + "%", text_color = netEdge >= 0 ? color.green : color.red)
    table.cell(t, 0, 7, "Verdict")
    table.cell(t, 1, 7, netEdge > 0 and pctIn > 70 ? "range-bound: viable" : netEdge > 0 ? "marginal" : "trending: IL wins")
    table.cell(t, 0, 8, "Capacity note")
    table.cell(t, 1, 8, "$47M total on-chain EUR TVL", text_color=color.gray)

alertcondition(not inBand and inBand[1], "Exited range", "Price left the market-making band — IL risk rising")
alertcondition(inBand and not inBand[1], "Entered range", "Price re-entered the band — fee accrual resumes")
