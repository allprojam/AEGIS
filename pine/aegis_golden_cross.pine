//@version=5
// Aegis Golden Cross — the best rule found across this entire investigation.
//
// MEASURED, not claimed. BTC 1h, 3 years, buy & hold +215.1%:
//   golden cross alone            +150.6%   (the best rule tested, incl. every custom one)
//   regime gate only              +133.4%
//   golden cross + regime gate    +118.9%
// ETH 1h, 1 bear year, buy & hold -35.7%:
//   golden cross alone             -25.8%   (+9.9pp vs hold)
//   golden cross + regime gate     +12.3%   (+48.0pp vs hold)
//
// THE TRADE-OFF, plainly: "Use Regime Gate" costs about 22 percentage points in a bull
// market and gains about 38 points in a bear market, by standing aside when price is
// below the long SMA. Neither setting beats buy & hold on BTC. This is a
// drawdown-reduction overlay, not alpha. Turn the gate ON if you want to survive a
// bear; leave it OFF if you want maximum participation.
strategy("Aegis Golden Cross", overlay=true,
     initial_capital=1000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.02,
     slippage=2, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false)

// ---------------- inputs ----------------
fastLen   = input.int(50,  "Fast SMA", minval=1)
slowLen   = input.int(200, "Slow SMA", minval=2)
useGate   = input.bool(false, "Use Regime Gate (costs ~22pp in a bull, gains ~38pp in a bear)")
gateLen   = input.int(400, "Regime SMA length", minval=10)
gateSlope = input.int(50,  "Regime slope lookback", minval=1)
needSlope = input.bool(false, "Also require the regime SMA to be rising")
useTrail  = input.bool(false, "Use ATR trailing stop")
atrLen    = input.int(14,  "ATR length", minval=2)
atrMult   = input.float(10.0, "ATR trail multiple", minval=1.0, step=0.5)

// ---------------- core: the golden cross ----------------
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
goldenCross = ta.crossover(fast, slow)
deathCross  = ta.crossunder(fast, slow)

// ---------------- optional regime gate ----------------
gate = ta.sma(close, gateLen)
gateOn = not useGate or (close > gate and (not needSlope or gate > gate[gateSlope]))

// ---------------- optional ATR trail ----------------
atr  = ta.atr(atrLen)
var float peak = na
var float stop = na
if strategy.position_size > 0
    peak := na(peak) ? high : math.max(peak, high)
    stop := na(stop) ? peak - atrMult * atr : math.max(stop, peak - atrMult * atr)

// ---------------- orders ----------------
if goldenCross and gateOn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    peak := high
    stop := high - atrMult * atr

trailHit = useTrail and strategy.position_size > 0 and low <= stop
gateOff  = useGate and strategy.position_size > 0 and not gateOn

if deathCross or trailHit or gateOff
    strategy.close("Long")

// ---------------- plots ----------------
plot(fast, "Fast SMA", color=color.new(color.orange, 0), linewidth=2)
plot(slow, "Slow SMA", color=color.new(color.blue, 0), linewidth=2)
plot(useGate ? gate : na, "Regime SMA", color=color.new(color.gray, 0), linewidth=1)
plot(useTrail and strategy.position_size > 0 ? stop : na, "ATR trail",
     color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plotshape(goldenCross and gateOn, "Golden Cross", style=shape.triangleup,
          location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(deathCross, "Death Cross", style=shape.triangledown,
          location=location.abovebar, color=color.new(color.red, 0), size=size.small)
bgcolor(useGate and not gateOn ? color.new(color.red, 94) : na)
