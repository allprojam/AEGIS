//@version=5
// Aegis Reclaim -- the best entry model found, and the first one that is statistically
// significant. USE ON 1 HOUR. It does NOT work on 5m (measured: negative on both assets).
//
// ENTRY (this is the new part): price reclaims the 100 while the 14 is ALREADY above it.
//   close crosses back above SMA(100) and SMA(14) > SMA(100)
// This fires EARLIER than a 14/100 cross, buying the first dip that touches the 100
// inside an established uptrend, instead of waiting for the 14 to cross back up.
//
// EXIT: exhaustion. Candle closes above the 14 AND above the upper Bollinger band
// drawn around the 100.
//
// MEASURED, long only, 5 bps round trip -- every number verified by two independent
// algorithms that agree to 0.000pp:
//
//   BTC 1h 3 years, buy & hold +215.1%
//     E1 14/100 cross (previous)   +53.5%   110 trades   t = 1.85
//     E2 reclaim 100 (THIS)       +101.0%    97 trades   t = 2.56   <-- significant
//       H1 +77.0% (t 3.02)   H2 +19.8% (t 0.98)   3 of 4 years positive
//   ETH 1h 1 year, buy & hold -35.7%
//     E2 reclaim 100               +34.0%    34 trades   t = 1.17
//       H1 +21.0%            H2 +14.8%     BOTH halves positive, +69.7pp vs buy & hold
//   BTC 5m 180d  -13.0%   ETH 5m 180d  -15.7%   <-- DO NOT USE ON 5m
//
// HONEST LIMITS: it still returns about half of buy & hold on BTC (101% vs 215%), the
// second half is weak (t 0.98), and 2026 was flat (-3.7%). It is statistically real and
// it beats holding in bear conditions (ETH: +69.7pp), but it is not a money printer.
strategy("Aegis Reclaim (1h)", overlay=true,
     initial_capital=1000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.02,
     slippage=2, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false)

fastLen = input.int(14,  "Fast SMA", minval=1)
slowLen = input.int(100, "Slow SMA", minval=2)
bbK     = input.float(2.0, "Bollinger k around the 100", minval=0.5, step=0.25)
exitMode= input.string("Exhaustion", "Exit mode", options=["Exhaustion","Cross back"])
allowShorts = input.bool(false, "Allow shorts (LOST -88% on BTC -- leave off)")

fast  = ta.sma(close, fastLen)
slow  = ta.sma(close, slowLen)
basis = ta.sma(close, slowLen)
dev   = bbK * ta.stdev(close, slowLen)
upper = basis + dev

// ---- E2 entry: reclaim the 100 inside an established uptrend ----
reclaim = ta.crossover(close, slow) and fast > slow
fallBack = ta.crossunder(close, slow)

goldenCross = ta.crossover(fast, slow)
deathCross  = ta.crossunder(fast, slow)

longExhaust = close > fast and close > upper

if reclaim and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if allowShorts and fallBack and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    if exitMode == "Exhaustion"
        if longExhaust
            strategy.close("Long")
    else
        if deathCross
            strategy.close("Long")
if strategy.position_size < 0 and goldenCross
    strategy.close("Short")

// ---- plots ----
pUp = plot(upper, "BB upper", color=color.new(color.purple, 60), linewidth=1)
plot(basis, "BB basis (100)", color=color.new(color.purple, 60), linewidth=1)
plot(fast, "Fast 14",  color=color.new(color.orange, 0), linewidth=2)
plot(slow, "Slow 100", color=color.new(color.blue, 0),   linewidth=2)
plotshape(reclaim, "Reclaim 100", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(strategy.position_size > 0 and longExhaust and exitMode == "Exhaustion",
     "Exhaustion exit", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.small)
bgcolor(fast > slow ? color.new(color.green, 95) : color.new(color.red, 95))
