//@version=6
// Aegis Regime v1 — visualise the range-vs-trend classifier.
//
// HONEST STATUS: this is a VISUALISATION, not a predictor. It was built and tested
// (aegis/CLASSIFIER_RESULT.md) and the test FAILED to find a metric that predicts
// whether range-LP will beat trend-spot:
//   - 315 hourly windows, real ETH data, 30-day forward horizon
//   - LP beat spot in only 6.3% of windows at the measured pool APR
//   - no metric separated LP-win rate monotonically across quartiles
//   - a rule trained on the first half (64.1% win rate in-sample) scored 20.0%
//     out of sample, WORSE than the 44.9% baseline
//
// So this script does NOT tell you when to LP. It shows you the regime metrics so
// you can see for yourself that the picture looks obvious in hindsight and does not
// separate forward outcomes. Use it for context, not for signals.
//
// The metrics shown are the two most standard regime measures:
//   1. EFFICIENCY RATIO (Kaufman): |net move| / sum|path|.  1 = clean trend, 0 = chop.
//   2. REALISED VOL: the volatility of the window, annualised.
// Both are computed from PAST bars only (never the current bar) to avoid repainting.
indicator("Aegis Regime v1", overlay=false, max_bars_back=5000)

// ---------------- inputs ----------------
grpW = "Window"
look    = input.int(720, "Lookback (bars)", minval=24, maxval=4000, group=grpW,
     tooltip="720 hourly bars = 30 days, matching the test horizon. Use 30*24 for daily-30d.")
grpT = "Thresholds"
erTrend = input.float(0.30, "Efficiency ratio: trend if above", step=0.05, group=grpT)
erChop  = input.float(0.15, "Efficiency ratio: chop if below",  step=0.05, group=grpT)
grpV = "Volatility"
volLen  = input.int(720, "Vol lookback", minval=24, maxval=4000, group=grpV)
grpB = "Band (for the range overlay)"
bandPct = input.float(10.0, "Range band +/- %", step=0.5, minval=0.5, maxval=50.0, group=grpB,
     tooltip="10% was the best band in the test. Note: wider bands won more often but still lost on average.")

// ---------------- efficiency ratio (Kaufman) ----------------
// past-only: shift by 1 bar so the current bar cannot influence the reading
netMove  = math.abs(ta.change(close, look))
pathSum  = math.sum(math.abs(ta.change(close)), look)
er       = pathSum > 0 ? netMove / pathSum : na
erPrev   = er[1]

// ---------------- realised volatility ----------------
lr      = math.log(close / close[1])
vol     = ta.stdev(lr, volLen)
barsYr  = 365.0 * (86400.0 / math.max(timeframe.in_seconds(), 1.0))
volAnn  = vol * math.sqrt(barsYr)

// ---------------- regime classification ----------------
isTrend = not na(erPrev) and erPrev >= erTrend
isChop  = not na(erPrev) and erPrev <= erChop
regime  = isTrend ? 1 : isChop ? -1 : 0

// ---------------- forward band (visual reference only) ----------------
anchor  = ta.sma(close, look)[1]
upper   = anchor * (1 + bandPct / 100)
lower   = anchor * (1 - bandPct / 100)
inBand  = close <= upper and close >= lower

// ---------------- plots ----------------
plot(er, "Efficiency ratio", color = isTrend ? color.new(color.orange, 0) : isChop ? color.new(color.teal, 0) : color.new(color.gray, 40), linewidth=2)
hline(erTrend, "Trend threshold", color=color.new(color.orange, 50), linestyle=hline.style_dashed)
hline(erChop,  "Chop threshold",  color=color.new(color.teal, 50),   linestyle=hline.style_dashed)

bgcolor(isTrend ? color.new(color.orange, 92) : isChop ? color.new(color.teal, 92) : na, title="Regime")

var table t = table.new(position.top_right, 2, 7, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Aegis Regime v1", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(t, 1, 0, "context, not a signal", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(t, 0, 1, "Efficiency ratio")
    table.cell(t, 1, 1, str.tostring(erPrev, "#.000"))
    table.cell(t, 0, 2, "Regime")
    table.cell(t, 1, 2, isTrend ? "TREND" : isChop ? "CHOP" : "neutral",
         text_color = isTrend ? color.orange : isChop ? color.teal : color.gray)
    table.cell(t, 0, 3, "Realised vol (ann.)")
    table.cell(t, 1, 3, str.tostring(volAnn * 100, "#.1") + "%")
    table.cell(t, 0, 4, "In band")
    table.cell(t, 1, 4, inBand ? "yes" : "no", text_color = inBand ? color.green : color.red)
    table.cell(t, 0, 5, "Test result")
    table.cell(t, 1, 5, "LP won 6.3% of windows", text_color=color.red)
    table.cell(t, 0, 6, "OOS walk-forward")
    table.cell(t, 1, 6, "20.0% vs 44.9% base", text_color=color.red)

alertcondition(isChop and not isChop[1], "Entered chop", "Efficiency ratio fell below the chop threshold")
alertcondition(isTrend and not isTrend[1], "Entered trend", "Efficiency ratio rose above the trend threshold")
