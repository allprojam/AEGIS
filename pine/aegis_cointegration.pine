//@version=6
// Aegis Cointegration v1 — visualise the FX statistical-arbitrage research.
//
// WHAT THIS IS: a diagnostic panel, NOT a strategy. It measures whether a second
// symbol (the "hedge leg") is statistically bound to the chart symbol, and plots the
// spread z-score used for mean-reversion entries.
//
// WHAT THE RESEARCH FOUND (aegis/fx_quant_response.md):
//  - Engle-Granger on 9 FX majors, 7781 daily obs: only 5 of 36 pairs rejected the
//    no-cointegration null at 5% (EUR/NOK t=-4.03, NOK/SEK -3.98, AUD/CAD -3.64,
//    CAD/NOK -3.64, AUD/NOK -3.54).
//  - The two pairs most cited in trading literature FAILED: AUD/NZD (t=-2.27) and
//    EUR/CHF (t=-2.69). EUR/CHF broke permanently when the SNB removed its floor in 2015.
//  - Half-lives measured 65-126 DAYS, not seconds. "Seconds" describes arbitrage,
//    not cointegration. A naive rolling-beta z-score system lost money on ALL FIVE
//    cointegrated pairs, hit rate ~50-51%.
//  - Therefore: treat a signal here as a HYPOTHESIS to investigate, not an entry.
//
// It re-estimates the hedge ratio on a rolling window so you can SEE beta instability,
// which is the specific reason naive pairs trading failed.
indicator("Aegis Cointegration v1", overlay=false, max_bars_back=5000)

// ---------------- inputs ----------------
grpS = "Second leg"
hedgeSym = input.symbol("NOKSEK",  "Hedge leg",        group=grpS)
srcOpt   = input.string("close", "Price source", options=["close","hlc3"], group=grpS)

grpW = "Estimation window"
winLen   = input.int(750,  "Rolling window (bars)", minval=60, maxval=4000, group=grpW,
     tooltip="The research used 750 DAILY bars (~3y) for the hedge ratio. Too short and beta is noise; too long and it misses structural breaks.")
zLook    = input.int(120,  "Z-score lookback",      minval=20, maxval=1000, group=grpW)

grpT = "Thresholds"
zEntry   = input.float(2.0, "Entry |z|",  step=0.1, minval=0.5, group=grpT)
zExit    = input.float(0.3, "Exit |z|",   step=0.1, minval=0.0, group=grpT)

grpC = "Costs (for the honest net line)"
commPct  = input.float(0.02, "Commission % per side", step=0.01, group=grpC,
     tooltip="Retail FX round trip is roughly 1-2bp; 2bp was used in the research backtest.")

// ---------------- second leg ----------------
hRaw = request.security(hedgeSym, timeframe.period, srcOpt == "close" ? close : hlc3, barmerge.gaps_off, barmerge.lookahead_off)

f_pick(float c, float h) => srcOpt == "close" ? c : h

pxY = f_pick(close, hlc3)
pxX = hRaw

// ---------------- rolling OLS of log(Y) on log(X) ----------------
// beta = Cov(x,y)/Var(x) over the window, alpha = ybar - beta*xbar
ly = math.log(pxY)
lx = math.log(pxX)

ybar = ta.sma(ly, winLen)
xbar = ta.sma(lx, winLen)
covXY = ta.sma(ly * lx, winLen) - ybar * xbar
varX  = ta.sma(lx * lx, winLen) - xbar * xbar
beta  = varX != 0 ? covXY / varX : na
alpha = ybar - beta * xbar

// residual (the spread) and its z-score
resid  = ly - (alpha + beta * lx)
rMean  = ta.sma(resid, zLook)
rSd    = ta.stdev(resid, zLook)
z      = rSd > 0 ? (resid - rMean) / rSd : na

// ---------------- plots ----------------
plot(z,   "Spread z-score", color = z >= zEntry ? color.new(color.red, 0) : z <= -zEntry ? color.new(color.lime, 0) : color.new(color.gray, 30), linewidth=2)
hline(0,        "mean",  color=color.new(color.gray, 50))
hline(zEntry,   "+entry", color=color.new(color.red, 40),  linestyle=hline.style_dashed)
hline(-zEntry,  "-entry", color=color.new(color.lime, 40), linestyle=hline.style_dashed)
hline(zExit,    "+exit",  color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(-zExit,   "-exit",  color=color.new(color.gray, 70), linestyle=hline.style_dotted)

// beta on its own scale — instability here is the failure mode that killed naive pairs trading
plot(beta, "Hedge ratio beta", color=color.new(color.blue, 40), display=display.data_window)

// ---------------- signal state ----------------
var int state = 0        // 0 flat, +1 short spread, -1 long spread
if not na(z)
    if state == 0
        if z >= zEntry
            state := -1
        else if z <= -zEntry
            state := 1
    else if math.abs(z) <= zExit
        state := 0

// ---------------- honest cost accounting ----------------
// research result: naive rolling-beta z-score lost on all 5 cointegrated pairs.
tradeRet = (resid - resid[1]) - beta * 0.0      // spread P&L in log space
var float eqGross = 0.0
var float eqNet   = 0.0
var float trades  = 0.0
step = nz(tradeRet, 0.0) * state
eqGross += state != 0 ? step : 0.0
if ta.change(state) != 0
    trades += 1
    eqNet += -commPct / 100.0
eqNet += state != 0 ? step : 0.0

plot(eqGross * 100, "Gross spread P&L (x100)", color=color.new(color.teal, 0), display=display.data_window)
plot(eqNet   * 100, "Net of costs (x100)",     color=color.new(color.orange, 0), display=display.data_window)

// ---------------- on-chart diagnostics ----------------
var table diag = table.new(position.top_right, 2, 7, border_width=1)
if barstate.islast
    table.cell(diag, 0, 0, "Aegis Cointegration v1", bgcolor=color.new(color.blue, 70), text_color=color.white)
    table.cell(diag, 1, 0, "diagnostic only", bgcolor=color.new(color.blue, 70), text_color=color.white)
    table.cell(diag, 0, 1, "Hedge leg")
    table.cell(diag, 1, 1, hedgeSym)
    table.cell(diag, 0, 2, "Beta (current)")
    table.cell(diag, 1, 2, str.tostring(beta, "#.000"))
    table.cell(diag, 0, 3, "Z-score")
    table.cell(diag, 1, 3, str.tostring(z, "#.00"), text_color = na(z) ? color.gray : z >= zEntry or z <= -zEntry ? color.orange : color.gray)
    table.cell(diag, 0, 4, "State")
    table.cell(diag, 1, 4, state == 1 ? "LONG spread" : state == -1 ? "SHORT spread" : "flat")
    table.cell(diag, 0, 5, "Net P&L (x100)")
    table.cell(diag, 1, 5, str.tostring(eqNet * 100, "#.0"), text_color = eqNet >= 0 ? color.green : color.red)
    table.cell(diag, 0, 6, "Signals taken")
    table.cell(diag, 1, 6, str.tostring(trades, "#"))

// ---------------- alerts ----------------
alertcondition(ta.change(state) == -1, "Short spread", "Z-score crossed +entry on the cointegration spread")
alertcondition(ta.change(state) ==  1, "Long spread",  "Z-score crossed -entry on the cointegration spread")
alertcondition(ta.change(state) ==  0, "Exit spread",  "Z-score returned toward the mean")
